# GameForge 48-Hour Jam
# Educational game development competition powered by AeThex

reality GameForge {
    type: "developer_education"
    platforms: [roblox, uefn, vrchat, spatial, web]
    duration: 48_hours
}

passport participant_badge {
    type: achievement
    cross_platform: true
    data: {
        team: "random_assigned"
        progress: 0
        mentor_assists: 0
    }
}

workflow GameForge_48h_Jam {
    duration: 48_hours
    platform: all
    
    stage registration {
        when developer.registers {
            passport participant {
                type: badge
                granted: timestamp
            }
            notify "Welcome to GameForge!"
            reveal "You have 48 hours to create magic"
        }
    }
    
    stage team_formation {
        journey AssignTeams(participants) {
            shuffle participants
            create teams of 3_to_5
            notify "Your team awaits in Discord"
        }
    }
    
    stage development {
        countdown: 48_hours
        
        journey MonitorProgress(teams) {
            observe teams every 6_hours {
                if team.stuck {
                    notify "Need a mentor? We're here to help"
                    offer mentor_connection
                }
                
                if team.progress > 50_percent {
                    notify "You're halfway there! Keep building!"
                }
            }
        }
    }
    
    stage submission {
        deadline: strict
        
        when team.submits(game) {
            verify game.playable
            verify game.cross_platform
            
            if verified {
                notify "Submission received! Good luck!"
                add_to showcase
            }
        }
    }
    
    stage judging {
        journey EvaluateGames(submissions) {
            parallel judge_reviews
            
            criteria: [
                "Innovation: 30%",
                "Cross-platform: 25%",
                "Polish: 25%",
                "Fun Factor: 20%"
            ]
            
            calculate winner {
                aggregate scores
                reveal "And the winner is..."
            }
        }
    }
    
    stage celebration {
        broadcast "Developer of Tomorrow award goes to..."
        reveal winner.team
        
        notify "Every participant helped push gaming forward"
        
        grant all_participants {
            passport completion_badge
            passport portfolio_piece
            passport community_access
        }
    }
}

signal countdown < 6_hours {
    broadcast "Final sprint! 6 hours remaining!"
}

signal countdown < 1_hour {
    broadcast "ONE HOUR LEFT! Polish and submit!"
}

journey ProvideResources(team) {
    reveal resources: {
        "AeThex Docs": "https://docs.aethex.foundation"
        "Example Templates": "https://github.com/aethex"
        "Discord Support": "#gameforge-help"
        "Mentor Hours": "Every 6 hours"
    }
}
