# Railway Environment Variables for aethex.net Frontend
# This frontend calls the backend API at api.aethex.cloud

# Main site URL
VITE_MAIN_SITE_URL=https://aethex.net

# Backend API URL
VITE_API_BASE_URL=https://api.aethex.cloud/v1

# Auth Domain (same backend)
VITE_AUTH_DOMAIN=https://api.aethex.cloud

# Status Page
VITE_STATUS_URL=https://status.aethex.cloud

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Node Environment
NODE_ENV=production
